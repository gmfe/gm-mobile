{
  "extends": "ts-config-gm-react-app/tsconfig",
  "types" : [
    "react-dom",
    "swiper",
  ],
  "compilerOptions": {
    "jsx": "react",
    "importsNotUsedAsValues": "preserve",
    "ignoreDeprecations": "5.0",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["mini-program/*"],
      "@gm-mobile/*": ["packages/*"]
    }
  },
  "include": [
    "**/*.ts", "**/*.tsx",
    "packages/**/*",
    "global.d.ts",
  ],
  "exclude": ["node_modules"]
}
